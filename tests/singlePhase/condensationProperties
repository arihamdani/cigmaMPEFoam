FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      condensationProperties;
}

solveWallCondensation   yes;
wallCondensationModel   diffusionLayer;
condensingSpecie        H2O;
maxCondWallMassFlux     100;

saturationPressure
{
    type    ArdenBuck;
}

latentHeatModel
{
    type    polynomial;
}

